{
  "Jwt": {
    "Issuer": "BlogApi",
    "Audience": "BlogApp"
  },
  "RegistrationOtp": {
    "LifetimeMinutes": 2,
    "MaxAttempts": 5
  },
  "ImageStorage": {
    "BasePath": "/var/www/uploads",
    "BaseUrl": "/uploads",
    "MaxFileSize": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
