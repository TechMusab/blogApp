ConnectionStrings__DefaultConnection=postgresql://user:password@host:port/database?sslmode=require
Email__Smtp__Host=smtp.example.com
Email__Smtp__Port=587
Email__Smtp__EnableSsl=true
Email__Smtp__Username=your-email@example.com
Email__Smtp__Password=your-app-password
Email__Smtp__From=your-email@example.com
Jwt__Key=replace-with-a-long-random-production-secret
Cors__AllowedOrigins__0=https://your-frontend-domain.com
Cloudinary__CloudName=your-cloud-name
Cloudinary__ApiKey=your-api-key
Cloudinary__ApiSecret=your-api-secret
