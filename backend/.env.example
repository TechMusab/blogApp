# Database Configuration
ConnectionStrings__DefaultConnection=Host=localhost;Database=blogdb;Username=postgres;Password=your-password

# JWT Configuration (IMPORTANT: Use a secure random key at least 32 characters long)
Jwt__Key=your-super-secret-jwt-key-min-32-characters-long

# Email Configuration
Email__Provider=Resend
Resend__ApiKey=re_your-resend-api-key
Resend__FromEmail=your-email@example.com
Resend__FromName=Blog App

# Cloudinary Configuration (for production image storage)
Cloudinary__CloudName=your-cloud-name
Cloudinary__ApiKey=your-cloudinary-api-key
Cloudinary__ApiSecret=your-cloudinary-api-secret

# CORS Configuration (optional - overrides appsettings defaults)
# Cors__AllowedOrigins__0=http://localhost:5173
# Cors__AllowedOrigins__1=https://localhost:5173
